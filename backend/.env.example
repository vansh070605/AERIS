APP_NAME=AEIRAS
DEBUG=false
SECRET_KEY=change-me-in-production-use-secrets-token

# Database
DATABASE_URL=postgresql+asyncpg://aeiras:aeiras_pass@localhost:5432/aeiras_db
DATABASE_URL_SYNC=postgresql://aeiras:aeiras_pass@localhost:5432/aeiras_db

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_SECRET_KEY=change-me-for-production-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
